{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".storybook/{main,preview}.ts"],
      "ignoreDependencies": ["chromatic"]
    },
    "packages/core": {
      "entry": ["src/components/**/*.stories.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/utils": {
      "project": ["src/**/*.ts"]
    },
    "apps/ginga-ui.com": {
      "entry": ["src/examples/{en,ja}/*.tsx"]
    }
  }
}
