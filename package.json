{
  "name": "ginga-ui",
  "version": "0.17.0",
  "private": true,
  "description": "brand-new UI component library for web",
  "keywords": [
    "component",
    "library",
    "react",
    "ui"
  ],
  "homepage": "https://github.com/newt239/ginga-ui#readme",
  "bugs": {
    "url": "https://github.com/newt239/ginga-ui/issues"
  },
  "author": {
    "name": "newt239",
    "email": "ysti2019.win2020.st@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newt239/ginga-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "changeset-version": "changeset version && node scripts/sync-root-version.ts",
    "changeset-publish": "changeset publish",
    "changelog": "node scripts/generate-changelog.ts",
    "clean": "find . -type d \\( -name 'node_modules' -o -name '.turbo' -o -name 'dist' -o -name 'pnpm-lock.yaml' \\) -prune -exec rm -rf {} +",
    "dev": "turbo run dev --filter=./packages/**",
    "build": "turbo run build --filter=./packages/**",
    "build:fast": "turbo run build:fast --filter=./packages/**",
    "lint": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "stylelint": "stylelint \"./**/*.css\" --fix",
    "knip": "knip",
    "docs": "pnpm --prefix apps/ginga-ui.com dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@storybook/addon-links": "10.6.7",
    "@storybook/builder-vite": "10.6.7",
    "@storybook/react": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tsdown/css": "0.23.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chromatic": "18.14.5",
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "storybook": "10.6.7",
    "stylelint": "18.0.0",
    "stylelint-config-recess-order": "7.10.0",
    "stylelint-config-standard": "41.0.0",
    "tsdown": "0.23.7",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0"
}
